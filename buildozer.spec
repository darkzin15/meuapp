[app]
title = Guilherme Player
package.name = guilhermeplayer
package.domain = org.guilherme.player
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,mp3,mp4
version = 1.0
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,READ_EXTERNAL_STORAGE,WRITE_EXTERNAL_STORAGE,READ_MEDIA_AUDIO,READ_MEDIA_VIDEO
android.api = 33
android.minapi = 21
android.ndk = 25b
android.gradle_dependencies =
p4a.branch = master

[buildozer]
log_level = 2
warn_on_root = 1
